# Tunnel identity. Existing tg-bt installation: awg-new.
INTERFACE=awg-new
CONFIG_PATH=/etc/amnezia/amneziawg/awg-new.conf
SERVICE=awg-quick@awg-new.service

# All requests are bound to the AWG interface. At least CHECK_QUORUM URLs
# must answer before the tunnel is considered usable.
CHECK_URLS="https://github.com/ https://telegram.org/ https://www.cloudflare.com/cdn-cgi/trace"
CHECK_QUORUM=2
CHECK_INTERVAL=2min
CURL_TIMEOUT=12
BIND_TO_INTERFACE=1

# This prevents a silent direct-Internet fallback from looking healthy.
REQUIRE_WARP=1
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace
MAX_HANDSHAKE_AGE=300

# Three failed timer runs (about six minutes with the default interval) are
# required before repair starts.
FAILURES_BEFORE_REPAIR=3
REPAIR_WAIT=12

# A restart is tried before a new Cloudflare WARP registration is created.
ALLOW_HARD_RESTART=1
ROTATION_COOLDOWN=1800
MAX_ROTATIONS_PER_DAY=4
BACKUPS_KEEP=10

# Comma-separated. The next endpoint is selected on every rotation attempt.
WARP_ENDPOINTS=162.159.192.1:500

# Keep local routing hooks and the exact AWG 2.0 obfuscation template from an
# adopted warp-gen profile. Credentials, addresses and peer data are replaced.
PRESERVE_DIRECTIVES=Table,PreUp,PostUp,PreDown,PostDown,S1,S2,S3,S4,Jc,Jmin,Jmax,H1,H2,H3,H4,I1,I2,I3,I4,I5

GENERATOR_PATH=/usr/local/lib/awg-warp-guardian/generate-warp-config
GENERATOR_TIMEOUT=90
# Optional bootstrap proxy used only to register a new WARP profile.
GENERATOR_HTTPS_PROXY=
STATE_DIR=/var/lib/awg-warp-guardian
