# Example tunnel identity.
INTERFACE=awg-warp
CONFIG_PATH=/etc/amnezia/amneziawg/awg-warp.conf
SERVICE=awg-quick@awg-warp.service

# All requests are bound to the AWG interface. At least CHECK_QUORUM URLs
# must answer before the tunnel is considered usable.
CHECK_URLS="https://github.com/ https://telegram.org/ https://www.cloudflare.com/cdn-cgi/trace"
CHECK_QUORUM=2
CHECK_INTERVAL=2min
# Number of fresh warp-gen candidates tested during installation and repair.
CANDIDATE_ATTEMPTS=10
# These values mirror the controls on https://warp-gen.github.io/ and are
# reused unchanged for every future candidate.
EXCLUDE_LAN=1
WARP_AWG_VARIANT=1
WARP_DNS_PRESET=cf
WARP_SERVER_PRESET=def
WARP_IPV6=1
WARP_KEEPALIVE=0
CURL_TIMEOUT=12
BIND_TO_INTERFACE=1

# This prevents a silent direct-Internet fallback from looking healthy.
REQUIRE_WARP=1
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace
MAX_HANDSHAKE_AGE=300

# Three failed timer runs (about six minutes with the default interval) are
# required before repair starts.
FAILURES_BEFORE_REPAIR=3
REPAIR_WAIT=12

# A restart is tried before a fresh config is requested from warp-gen.
ALLOW_HARD_RESTART=1
ROTATION_COOLDOWN=1800
MAX_ROTATIONS_PER_DAY=4
BACKUPS_KEEP=10

GENERATOR_PATH=/usr/local/lib/awg-warp-guardian/generate-warp-config
GENERATOR_TIMEOUT=90
# A compatible mirror must expose the same script.js next to its page.
GENERATOR_SITE_URL=https://warp-gen.github.io
# Optional space-separated warp-gen config API overrides. Empty means: read the
# current fallback list from the selected site's script.js.
GENERATOR_DATA_URLS=
# Optional proxy used only while requesting a fresh profile.
GENERATOR_HTTPS_PROXY=
STATE_DIR=/var/lib/awg-warp-guardian
