# Example tunnel identity.
INTERFACE=awg-warp
CONFIG_PATH=/etc/amnezia/amneziawg/awg-warp.conf
SERVICE=awg-quick@awg-warp.service

# All requests are bound to the AWG interface. At least CHECK_QUORUM URLs
# must answer before the tunnel is considered usable.
CHECK_URLS="https://github.com/ https://telegram.org/ https://www.cloudflare.com/cdn-cgi/trace"
CHECK_QUORUM=2
CHECK_INTERVAL=2min
# Used only while creating a brand-new profile during installation (1-20).
INITIAL_GENERATION_ATTEMPTS=10
# 1 keeps RFC1918, loopback/link-local, ULA, and other local ranges direct.
EXCLUDE_LAN=1
CURL_TIMEOUT=12
BIND_TO_INTERFACE=1

# This prevents a silent direct-Internet fallback from looking healthy.
REQUIRE_WARP=1
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace
MAX_HANDSHAKE_AGE=300

# Three failed timer runs (about six minutes with the default interval) are
# required before repair starts.
FAILURES_BEFORE_REPAIR=3
REPAIR_WAIT=12

# A restart is tried before a new Cloudflare WARP registration is created.
ALLOW_HARD_RESTART=1
ROTATION_COOLDOWN=1800
MAX_ROTATIONS_PER_DAY=4
BACKUPS_KEEP=10

# Comma-separated. One recovery run tries these Cloudflare-supported WireGuard
# ports in order until a replacement profile passes health checks.
WARP_ENDPOINTS=162.159.192.1:2408,162.159.192.1:500,162.159.192.1:1701,162.159.192.1:4500

# Keep custom local hooks. Guardian-owned route hooks are regenerated for the
# candidate endpoint; the generator's AWG template and credentials stay intact.
PRESERVE_DIRECTIVES=Table,PreUp,PostUp,PreDown,PostDown

GENERATOR_PATH=/usr/local/lib/awg-warp-guardian/generate-warp-config
GENERATOR_TIMEOUT=90
# Official API by default. A custom value must expose compatible /reg routes.
GENERATOR_API_URL=https://api.cloudflareclient.com/v0i1909051800
# Optional bootstrap proxy used only to register a new WARP profile.
GENERATOR_HTTPS_PROXY=
STATE_DIR=/var/lib/awg-warp-guardian
