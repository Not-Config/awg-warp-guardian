#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: generate-warp-config OUTPUT.conf" >&2
  exit 64
fi

readonly OUTPUT=$1
readonly SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly ROUTE_POLICY_SCRIPT="${SCRIPT_DIR}/route-policy.sh"
UPSTREAM_SCRIPT="${SCRIPT_DIR}/vendor/warp_generator.sh"
if [[ ! -x ${UPSTREAM_SCRIPT} && -x ${SCRIPT_DIR}/../vendor/warp_generator.sh ]]; then
  UPSTREAM_SCRIPT="${SCRIPT_DIR}/../vendor/warp_generator.sh"
fi
readonly UPSTREAM_SCRIPT
readonly ENDPOINT=${WARP_ENDPOINT:-162.159.192.1:500}
API_BASE_URL=${WARP_API_BASE_URL:-https://api.cloudflareclient.com/v0i1909051800}
API_BASE_URL=${API_BASE_URL%/}
readonly API_BASE_URL
EXCLUDE_LAN=${WARP_EXCLUDE_LAN:-1}
readonly EXCLUDE_LAN

generator_log() {
  printf '[generator] %s\n' "$*" >&2
}

if [[ ! -x "${UPSTREAM_SCRIPT}" ]]; then
  echo "Bundled WARP generator is missing" >&2
  exit 69
fi
if [[ ! -r ${ROUTE_POLICY_SCRIPT} ]]; then
  echo "Bundled route policy helper is missing" >&2
  exit 69
fi
# shellcheck disable=SC1090
source "${ROUTE_POLICY_SCRIPT}"
if ! awg_valid_lan_mode "${EXCLUDE_LAN}"; then
  echo "WARP_EXCLUDE_LAN must be 0 or 1" >&2
  exit 65
fi
if [[ ! "${ENDPOINT}" =~ ^(\[[0-9A-Fa-f:]+\]|[A-Za-z0-9.-]+):[0-9]{1,5}$ ]]; then
  echo "WARP_ENDPOINT has an invalid host:port value" >&2
  exit 65
fi
endpoint_port=${ENDPOINT##*:}
endpoint_port_number=$((10#${endpoint_port}))
if ((endpoint_port_number < 1 || endpoint_port_number > 65535)); then
  echo "WARP_ENDPOINT port must be between 1 and 65535" >&2
  exit 65
fi
if [[ ! ${API_BASE_URL} =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]+)*$ ]]; then
  echo "WARP_API_BASE_URL must be an HTTPS base URL without a query or fragment" >&2
  exit 65
fi
api_authority=${API_BASE_URL#https://}
api_authority=${api_authority%%/*}
if [[ ${api_authority} == *:* ]]; then
  api_port=${api_authority##*:}
  api_port_number=$((10#${api_port}))
  if ((api_port_number < 1 || api_port_number > 65535)); then
    echo "WARP_API_BASE_URL port must be between 1 and 65535" >&2
    exit 65
  fi
fi

work_dir=$(mktemp -d)
cleanup() {
  rm -rf -- "${work_dir}"
}
trap cleanup EXIT

generator_log "Ready configurations are not downloaded: the private key is created locally."
generator_log "Registration API: ${API_BASE_URL}"
if [[ -n ${HTTPS_PROXY:-${https_proxy:-}} ]]; then
  generator_log "Transport: configured HTTP/HTTPS proxy (address hidden)."
else
  generator_log "Transport: direct HTTPS connection."
fi
generator_log "Creating a local key and requesting WARP registration parameters..."
if [[ ${EXCLUDE_LAN} == 1 ]]; then
  generator_log "LAN exclusion: enabled (private/local networks stay direct)."
else
  generator_log "LAN exclusion: disabled (full IPv4/IPv6 tunnel)."
fi

if ! (
  cd -- "${work_dir}"
  # The bundled MIT-licensed generator is sanitized and performs no package
  # management or secret-bearing terminal output.
  WARP_GENERATOR_VERBOSE=1 \
  WARP_API_BASE_URL="${API_BASE_URL}" \
    bash "${UPSTREAM_SCRIPT}" >/dev/null
); then
  generator_log "Registration failed; no configuration was installed."
  exit 70
fi

if [[ ! -s "${work_dir}/warp.conf" ]]; then
  generator_log "API exchange finished, but the generator did not produce a config."
  exit 70
fi

generator_log "Registration accepted; peer parameters were received from the API."

sed -E "s|^[[:space:]]*Endpoint[[:space:]]*=.*$|Endpoint = ${ENDPOINT}|" \
  "${work_dir}/warp.conf" >"${work_dir}/endpoint.conf"
if ! awg_apply_route_policy \
  "${work_dir}/endpoint.conf" "${work_dir}/final.conf" "${EXCLUDE_LAN}"; then
  generator_log "Could not apply the selected LAN routing policy."
  exit 70
fi
install -D -m 600 "${work_dir}/final.conf" "${OUTPUT}"
config_size=$(wc -c <"${OUTPUT}")
generator_log "Configuration assembled locally and saved (${config_size} bytes; secrets hidden)."
