[Unit]
Description=Health check and recovery for an AmneziaWG WARP tunnel
Documentation=https://github.com/Not-Config/awg-warp-guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/awg-warp-guardian run
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/awg-warp-guardian /etc/amnezia/amneziawg /etc/amneziawg /var/lib/awg-warp-guardian
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TimeoutStartSec=5min
